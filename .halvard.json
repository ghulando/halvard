{
  "version": 1,
  "gate": [
    "sh",
    "-c",
    "npm run format:check && npm test && npm run verify-install && npm pack --dry-run"
  ],
  "workflow": {
    "reviewExclude": ["herdr-app/preview.png"],
    "reviewContext": [
      "core/**",
      "adapters/**",
      "bin/**",
      "docs/*.md",
      "skills/**",
      "package.json"
    ],
    "reviewers": {
      "codex": {},
      "claude": {},
      "ollama": {
        "model": "glm-5.2:cloud",
        "transport": "pi"
      }
    }
  }
}
